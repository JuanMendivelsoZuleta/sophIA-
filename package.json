{
  "name": "sophia",
  "version": "0.1.0",
  "private": true,
  "description": "Sofía: asistente de escritorio con rostro en un celular viejo y cerebro en el PC.",
  "type": "module",
  "packageManager": "pnpm@10.26.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @sophia/server dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "depcruise": "depcruise apps/server/src packages/protocol/src --config .dependency-cruiser.cjs",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/node": "^22.20.5",
    "dependency-cruiser": "^18.7.2",
    "lefthook": "^2.2.2",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
