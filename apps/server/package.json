{
  "name": "@sophia/server",
  "version": "0.1.0",
  "private": true,
  "description": "El cerebro de Sofía: servidor Node.js + TypeScript con arquitectura limpia.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --conditions=@sophia/source src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@sophia/protocol": "workspace:*",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15"
  }
}
