# Copia este archivo como .env y completa los valores. .env nunca se sube a git.

# --- Servidor ---
# Puerto HTTP/WebSocket del servidor (el celular accede por adb reverse a este puerto).
PORT=8080
# development | production | test
NODE_ENV=development
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- Gemini (obligatorio a partir del hito 1.4) ---
# API key gratuita de Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Modelo Live de audio nativo del free tier. Verificar el vigente en la documentación oficial (hito 1.4).
GEMINI_LIVE_MODEL=

# --- Wake word (hito 1.5) ---
# Umbral de detección de openWakeWord (0..1).
WAKEWORD_THRESHOLD=0.5
